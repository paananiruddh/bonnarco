# Copy this file to .env.local and fill in real values before deploying.
# See /CONFIG-CHECKLIST.md for the full list of what's outstanding.

# The production domain, once confirmed. Used for canonical URLs, the
# sitemap and social preview metadata.
NEXT_PUBLIC_SITE_URL=https://www.bonnarco.com.au

# Enquiry form delivery (see src/lib/send-enquiry-notification.ts).
# Without these three set, enquiries are still accepted and best-effort
# logged to .data/enquiries.log on the server, but NOT emailed anywhere —
# fine for local development, not acceptable for a live launch.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
RESEND_FROM_EMAIL=
